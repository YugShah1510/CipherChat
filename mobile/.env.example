# Use this project's existing Supabase URL and publishable key.
# Expo bundles EXPO_PUBLIC_ values into the client app, so only public project
# configuration belongs here. Never place a service-role key in a mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
