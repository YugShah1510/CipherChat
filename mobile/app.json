{
  "expo": {
    "name": "CipherChat",
    "slug": "cipherchat",
    "version": "1.0.0",
    "scheme": "cipherchat-mobile",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.cipherchat.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cipherchat.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#10131d",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10131d",
          "image": "./assets/images/icon.png",
          "imageWidth": 84
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bfd119b1-ae44-4d16-ae44-a95a3b0fba88"
      }
    },
    "owner": "yugshah15s-team"
  }
}
