-- CipherChat Mobile-only messaging schema draft.
--
-- DRAFT ONLY: this file is deliberately suffixed `.sql.draft` and must not be
-- applied as-is. No SQL in this file has been executed.
--
-- Preconditions to verify against the linked project before converting this
-- into an approved migration:
--   1. `auth.users(id)` and the Supabase `authenticated`/`anon` roles exist.
--   2. Apply/review the separate Desktop Realtime repair draft first; it sets
--      the publication event flags and adds only Desktop messages/reactions.
--      `supabase_realtime` must exist before this draft adds Mobile messages.
--   3. Existing grants, default privileges, role names, RLS, and helper functions
--      have been reviewed so this additive draft does not overwrite assumptions.
--   4. `public.profiles(id, full_name)` exists and `id` identifies auth.users.
--      Account deletion is explicitly RESTRICTED by the foreign keys below
--      until a cleanup policy is designed; do not assume auth-user deletion
--      should erase conversation history.
--   5. Mobile group chats, media, reactions, and server-trusted app identity are
--      intentionally outside this first direct-message schema.
--
-- Design: Desktop relations remain untouched. Mobile gets its own public-key,
-- conversation, membership, and message relations. Public JWKs are JSONB; private
-- keys must remain in Mobile SecureStore and must never be sent to these RPCs.

begin;

create table public.mobile_user_public_keys (
  user_id uuid primary key references auth.users (id) on delete restrict,
  public_key jsonb not null,
  created_at timestamptz not null default now(),
  constraint mobile_user_public_keys_public_jwk_check check (
    coalesce(
      jsonb_typeof(public_key) = 'object'
      and public_key ->> 'kty' = 'EC'
      and public_key ->> 'crv' = 'P-256'
      and jsonb_typeof(public_key -> 'x') = 'string'
      and (public_key ->> 'x') ~ '^[A-Za-z0-9_-]{43}$'
      and jsonb_typeof(public_key -> 'y') = 'string'
      and (public_key ->> 'y') ~ '^[A-Za-z0-9_-]{43}$'
      and not (public_key ? 'd'),
      false
    )
  )
);

create table public.mobile_conversations (
  id uuid primary key default gen_random_uuid(),
  type text not null default 'direct',
  created_by uuid not null references auth.users (id) on delete restrict,
  direct_pair_key text not null unique,
  created_at timestamptz not null default now(),
  constraint mobile_conversations_direct_only_check check (type = 'direct')
);

create table public.mobile_conversation_members (
  conversation_id uuid not null
    references public.mobile_conversations (id) on delete cascade,
  user_id uuid not null references auth.users (id) on delete restrict,
  created_at timestamptz not null default now(),
  primary key (conversation_id, user_id)
);

create index mobile_conversation_members_user_id_idx
  on public.mobile_conversation_members (user_id, conversation_id);

create index mobile_conversations_created_by_idx
  on public.mobile_conversations (created_by);

create table public.mobile_messages (
  id uuid primary key default gen_random_uuid(),
  conversation_id uuid not null
    references public.mobile_conversations (id) on delete cascade,
  sender_id uuid not null references auth.users (id) on delete restrict,
  ciphertext text not null,
  created_at timestamptz not null default now()
);

create index mobile_messages_conversation_created_idx
  on public.mobile_messages (conversation_id, created_at, id);

create index mobile_messages_sender_id_idx
  on public.mobile_messages (sender_id);

alter table public.mobile_user_public_keys enable row level security;
alter table public.mobile_conversations enable row level security;
alter table public.mobile_conversation_members enable row level security;
alter table public.mobile_messages enable row level security;

-- This SECURITY DEFINER helper avoids recursive RLS checks when a policy needs
-- to test membership in the same membership table. It can only inspect the
-- current caller's membership, never a caller-selected user ID.
create function public.is_current_user_mobile_member(p_conversation_id uuid)
returns boolean
language plpgsql
stable
security definer
set search_path = ''
as $function$
begin
  if auth.uid() is null then
    return false;
  end if;

  return exists (
    select 1
    from public.mobile_conversation_members as member_row
    where member_row.conversation_id = p_conversation_id
      and member_row.user_id = auth.uid()
  );
end;
$function$;

-- Register the caller's public key once. Repeating the same key is idempotent;
-- a different existing key is rejected and never replaced by this function.
create function public.register_mobile_public_key(p_public_key jsonb)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $function$
declare
  v_user_id uuid := auth.uid();
  v_canonical_key jsonb;
  v_registered_key jsonb;
begin
  if v_user_id is null then
    raise exception 'Authentication is required.' using errcode = '28000';
  end if;

  if not coalesce(
    jsonb_typeof(p_public_key) = 'object'
    and p_public_key ->> 'kty' = 'EC'
    and p_public_key ->> 'crv' = 'P-256'
    and jsonb_typeof(p_public_key -> 'x') = 'string'
    and (p_public_key ->> 'x') ~ '^[A-Za-z0-9_-]{43}$'
    and jsonb_typeof(p_public_key -> 'y') = 'string'
    and (p_public_key ->> 'y') ~ '^[A-Za-z0-9_-]{43}$'
    and not (p_public_key ? 'd'),
    false
  ) then
    raise exception 'A public P-256 JWK is required.' using errcode = '22023';
  end if;

  -- SQL validates the public JWK shape and encoding, but not that x/y is a
  -- point on P-256. Mobile must validate the generated key pair locally before
  -- calling this RPC; a trusted verifier is needed for server-side curve checks.

  -- Store only the cryptographic public coordinates in a stable JWK shape.
  -- Optional JWK metadata and JSON property order do not change key identity.
  v_canonical_key := jsonb_build_object(
    'kty', 'EC', 'crv', 'P-256',
    'x', p_public_key ->> 'x',
    'y', p_public_key ->> 'y'
  );

  insert into public.mobile_user_public_keys (user_id, public_key)
  values (v_user_id, v_canonical_key)
  on conflict (user_id) do nothing;

  select key_row.public_key
    into v_registered_key
  from public.mobile_user_public_keys as key_row
  where key_row.user_id = v_user_id;

  if v_registered_key is distinct from v_canonical_key then
    raise exception 'A different Mobile identity is already registered for this account.'
      using errcode = '23505';
  end if;

  return v_registered_key;
end;
$function$;

-- Search only accounts with a Mobile public key. The profiles table shape is a
-- precondition above; this function returns no emails or other profile fields.
create function public.search_mobile_users(p_query text, p_limit integer default 20)
returns table (user_id uuid, full_name text)
language plpgsql
stable
security definer
set search_path = ''
as $function$
declare
  v_user_id uuid := auth.uid();
  v_query text := lower(trim(coalesce(p_query, '')));
  v_pattern text;
begin
  if v_user_id is null then
    raise exception 'Authentication is required.' using errcode = '28000';
  end if;
  if length(v_query) < 2 or length(v_query) > 80 then
    raise exception 'Search text must be between 2 and 80 characters.' using errcode = '22023';
  end if;

  -- Escape LIKE metacharacters so the query is treated as literal user text.
  v_query := replace(replace(replace(v_query, E'\\', E'\\\\'), '%', E'\\%'), '_', E'\\_');
  v_pattern := '%' || v_query || '%';

  return query
    select profile_row.id, profile_row.full_name::text
    from public.profiles as profile_row
    join public.mobile_user_public_keys as key_row
      on key_row.user_id = profile_row.id
    where profile_row.id <> v_user_id
      and profile_row.full_name ilike v_pattern escape E'\\'
    order by profile_row.full_name, profile_row.id
    limit greatest(1, least(coalesce(p_limit, 20), 50));
end;
$function$;

-- Create or return a direct Mobile chat. The pair key is canonicalized in the
-- database, and creation plus both memberships are committed atomically.
create function public.create_mobile_direct_conversation(p_other_user_id uuid)
returns uuid
language plpgsql
security definer
set search_path = ''
as $function$
declare
  v_user_id uuid := auth.uid();
  v_pair_key text;
  v_conversation_id uuid;
  v_attempt integer := 0;
begin
  if v_user_id is null then
    raise exception 'Authentication is required.' using errcode = '28000';
  end if;
  if p_other_user_id is null or p_other_user_id = v_user_id then
    raise exception 'Choose another Mobile user.' using errcode = '22023';
  end if;
  if not exists (
    select 1 from public.mobile_user_public_keys key_row
    where key_row.user_id = v_user_id
  ) or not exists (
    select 1 from public.mobile_user_public_keys key_row
    where key_row.user_id = p_other_user_id
  ) then
    raise exception 'Both participants must have a registered Mobile identity.'
      using errcode = '23503';
  end if;

  v_pair_key := least(v_user_id::text, p_other_user_id::text)
    || ':' || greatest(v_user_id::text, p_other_user_id::text);

  -- The unique pair key is the final duplicate guard. The loop handles the
  -- concurrent-insert case under READ COMMITTED without relying on a stale read.
  -- Under a stricter transaction snapshot, fail safely after bounded retries;
  -- the unique constraint still prevents duplicate pair rows.
  loop
    select conversation_row.id
      into v_conversation_id
    from public.mobile_conversations as conversation_row
    where conversation_row.direct_pair_key = v_pair_key
    for update;
    if found then
      exit;
    end if;

    insert into public.mobile_conversations (created_by, direct_pair_key)
    values (v_user_id, v_pair_key)
    on conflict (direct_pair_key) do nothing
    returning id into v_conversation_id;
    if found then
      exit;
    end if;

    v_attempt := v_attempt + 1;
    if v_attempt >= 3 then
      raise exception 'Concurrent conversation creation; retry the request.'
        using errcode = '40001';
    end if;
  end loop;

  insert into public.mobile_conversation_members (conversation_id, user_id)
  values (v_conversation_id, v_user_id), (v_conversation_id, p_other_user_id)
  on conflict (conversation_id, user_id) do nothing;

  return v_conversation_id;
end;
$function$;

-- A caller can read their own public key and the other participants' public
-- keys only after they share a Mobile conversation. Search returns profile
-- labels but does not grant direct table access to every Mobile key row.
create policy mobile_user_public_keys_authenticated_select
  on public.mobile_user_public_keys
  for select to authenticated
  using (
    user_id = auth.uid()
    or exists (
      select 1
      from public.mobile_conversation_members as caller_member
      join public.mobile_conversation_members as peer_member
        on peer_member.conversation_id = caller_member.conversation_id
      where caller_member.user_id = auth.uid()
        and peer_member.user_id = mobile_user_public_keys.user_id
        and public.is_current_user_mobile_member(caller_member.conversation_id)
    )
  );

create policy mobile_conversations_member_select
  on public.mobile_conversations
  for select to authenticated
  using (public.is_current_user_mobile_member(id));

create policy mobile_conversation_members_participant_select
  on public.mobile_conversation_members
  for select to authenticated
  using (public.is_current_user_mobile_member(conversation_id));

create policy mobile_messages_member_select
  on public.mobile_messages
  for select to authenticated
  using (public.is_current_user_mobile_member(conversation_id));

create policy mobile_messages_member_sender_insert
  on public.mobile_messages
  for insert to authenticated
  with check (
    sender_id = auth.uid()
    and public.is_current_user_mobile_member(conversation_id)
  );

-- Restrict direct table access. The authenticated client can read only the
-- listed data and insert messages; identity and conversation writes use RPCs.
revoke all on table public.mobile_user_public_keys,
  public.mobile_conversations,
  public.mobile_conversation_members,
  public.mobile_messages
  from public, anon, authenticated;

grant select on table public.mobile_user_public_keys to authenticated;
grant select on table public.mobile_conversations to authenticated;
grant select on table public.mobile_conversation_members to authenticated;
grant select, insert on table public.mobile_messages to authenticated;

revoke all on function public.is_current_user_mobile_member(uuid) from public, anon, authenticated;
revoke all on function public.register_mobile_public_key(jsonb) from public, anon, authenticated;
revoke all on function public.search_mobile_users(text, integer) from public, anon, authenticated;
revoke all on function public.create_mobile_direct_conversation(uuid) from public, anon, authenticated;

grant execute on function public.is_current_user_mobile_member(uuid) to authenticated;
grant execute on function public.register_mobile_public_key(jsonb) to authenticated;
grant execute on function public.search_mobile_users(text, integer) to authenticated;
grant execute on function public.create_mobile_direct_conversation(uuid) to authenticated;

-- Add only Mobile messages to Realtime. The separate Desktop repair draft
-- handles public.messages and public.message_reactions and sets DML events.
-- This block is idempotent if Mobile messages are already in the publication.
do $realtime$
begin
  if not exists (
    select 1 from pg_catalog.pg_publication
    where pubname = 'supabase_realtime'
      and pubinsert and pubupdate and pubdelete
  ) then
    raise exception 'The supabase_realtime publication must exist and publish INSERT, UPDATE, and DELETE events. Apply/review the separate Realtime repair draft first.';
  end if;

  if not exists (
    select 1 from pg_catalog.pg_publication_tables
    where pubname = 'supabase_realtime'
      and schemaname = 'public'
      and tablename = 'mobile_messages'
  ) then
    execute 'alter publication supabase_realtime add table public.mobile_messages';
  end if;
end;
$realtime$;

commit;
